# 登录页认证 (推荐必须设置, 尤其公网)
DSH_AUTH_USERNAME=你的用户名
DSH_AUTH_PASSWORD=请设置一个足够长的独立密码(至少12位)

# 局域网直连 HTTPS 端口 (8443): 填 NAS 的局域网 IP 或域名 (不带协议/端口),
# 容器会自动生成自签名证书, 浏览器首次访问点一次"继续前往"即可。
# 这是必须的 —— dsh 前端用 crypto.randomUUID, 浏览器只在 HTTPS/localhost 提供,
# 纯 HTTP 局域网直连会导致 UI 报错。
# 注意: Cloudflare Tunnel 回源走的是 HTTP 端口 3080 (边缘已是正式 HTTPS),
#       与这里无关, 不需要忽略证书。
HTTPS_ACCESS_HOST=192.168.1.100

# 可选: 会话有效期天数 (默认 7)
# DSH_SESSION_DAYS=7
# 可选: 登录调试日志 (1=开启)
# DSH_AUTH_DEBUG=0

DSH_DATA_PATH=/实际绝对路径/docker/deepseek-harness/data
WORKSPACE_PATH=/实际绝对路径/docker/deepseek-harness/workspace

# 可选: 用 GitHub Actions 推送的镜像时设置
# DSH_IMAGE=ghcr.io/你的用户名/dsh-nas:latest
