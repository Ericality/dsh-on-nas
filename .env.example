# 访问地址: http://NAS局域网IP:3080 或 https://NAS局域网IP:3080 (登录页认证)
# 推荐设置用户名/密码, 启用前端登录页 (不设则无认证, 仅限可信局域网)
DSH_AUTH_USERNAME=你的用户名
DSH_AUTH_PASSWORD=请设置一个足够长的独立密码(至少12位)

# 重要: 纯 HTTP 局域网直连时, 浏览器会因安全上下文限制导致 UI 报错
# (crypto.randomUUID is not a function)。要局域网直接访问, 必须启用 HTTPS:
# 填 NAS 的局域网 IP 或域名 (不带协议/端口), 容器会自动生成自签名证书,
# 浏览器首次访问点一次"继续前往"即可。
# 若你只用 Cloudflare 隧道 (https://域名) 或 SSH 隧道 (localhost) 访问, 可留空。
HTTPS_ACCESS_HOST=192.168.1.100

# 可选: 会话有效期天数 (默认 7)
# DSH_SESSION_DAYS=7
# 可选: 登录调试日志 (1=开启)
# DSH_AUTH_DEBUG=0

DSH_DATA_PATH=/实际绝对路径/docker/deepseek-harness/data
WORKSPACE_PATH=/实际绝对路径/docker/deepseek-harness/workspace

# 可选: 用 GitHub Actions 推送的镜像时设置
# DSH_IMAGE=ghcr.io/你的用户名/dsh-nas:latest
